datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum TripVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum UserRole {
  OWNER
  EDITOR
  VIEWER
}

enum PlaceCategory {
  ATTRACTION
  RESTAURANT
  HOTEL
  TRANSPORT
  OTHER
}

// -----------------------------------------------------------------------------
// 1. AUTH & USERS MODULE
// -----------------------------------------------------------------------------

model User {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique @db.VarChar(255)
  password_hash           String?   @db.VarChar(255)
  full_name               String    @db.VarChar(100)
  avatar_url              String?   @db.Text
  bio                     String?   @db.Text
  phone_number            String?   @db.VarChar(20)
  is_verified             Boolean   @default(false)
  verify_token            String?   @db.VarChar(255)
  verify_token_expires_at DateTime? @db.Timestamptz
  google_id               String?   @unique @db.VarChar(255)
  created_at              DateTime  @default(now()) @db.Timestamptz
  updated_at              DateTime  @updatedAt @db.Timestamptz

  refresh_tokens  RefreshToken[]
  owned_trips     Trip[]          @relation("TripOwner")
  trip_members    TripMember[]
  trip_likes      TripLike[]
  trip_bookmarks  TripBookmark[]
  trip_comments   TripComment[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.VarChar(255)
  is_revoked Boolean  @default(false)
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// 2 & 3. TRIP MANAGEMENT & ITINERARY PLANNER MODULE
// -----------------------------------------------------------------------------

model Trip {
  id              String         @id @default(uuid()) @db.Uuid
  owner_id        String         @db.Uuid
  title           String         @db.VarChar(255)
  description     String?        @db.Text
  destination     String         @db.VarChar(255)
  start_date      DateTime       @db.Date
  end_date        DateTime       @db.Date
  cover_image_url String?        @db.Text
  visibility      TripVisibility @default(PRIVATE)
  is_deleted      Boolean        @default(false)
  clone_count     Int            @default(0)
  source_trip_id  String?        @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz
  updated_at      DateTime       @updatedAt @db.Timestamptz

  // Relations
  owner        User           @relation("TripOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  source_trip  Trip?          @relation("ClonedTrips", fields: [source_trip_id], references: [id], onDelete: SetNull)
  cloned_trips Trip[]         @relation("ClonedTrips")
  days         TripDay[]
  place_items  PlaceItem[]
  members      TripMember[]
  invites      TripInvite[]
  checklists   TripChecklist[]
  likes        TripLike[]
  bookmarks    TripBookmark[]
  comments     TripComment[]

  @@map("trips")
}

model TripDay {
  id         String   @id @default(uuid()) @db.Uuid
  trip_id    String   @db.Uuid
  day_number Int
  date       DateTime @db.Date
  created_at DateTime @default(now()) @db.Timestamptz

  trip        Trip        @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  place_items PlaceItem[]

  @@unique([trip_id, day_number])
  @@map("trip_days")
}

model PlaceItem {
  id                String        @id @default(uuid()) @db.Uuid
  trip_id           String        @db.Uuid
  trip_day_id       String?       @db.Uuid // Nullable = Unassigned Pool (Kho lưu tạm)
  place_name        String        @db.VarChar(255)
  formatted_address String?       @db.Text
  latitude          Float
  longitude         Float
  thumbnail_url     String?       @db.Text
  category          PlaceCategory @default(ATTRACTION)
  start_time        String?       @db.VarChar(10)
  duration_minutes  Int?
  notes             String?       @db.Text
  order_index       Float // Fractional Indexing: (A + B) / 2
  created_at        DateTime      @default(now()) @db.Timestamptz
  updated_at        DateTime      @updatedAt @db.Timestamptz

  trip     Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  trip_day TripDay? @relation(fields: [trip_day_id], references: [id], onDelete: SetNull)

  @@map("place_items")
}

// -----------------------------------------------------------------------------
// 4. RBAC COLLABORATION & MEMBERS MODULE
// -----------------------------------------------------------------------------

model TripMember {
  id        String   @id @default(uuid()) @db.Uuid
  trip_id   String   @db.Uuid
  user_id   String   @db.Uuid
  role      UserRole @default(VIEWER)
  joined_at DateTime @default(now()) @db.Timestamptz

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([trip_id, user_id])
  @@map("trip_members")
}

model TripInvite {
  id           String   @id @default(uuid()) @db.Uuid
  trip_id      String   @db.Uuid
  invite_token String   @unique @db.VarChar(255)
  email        String?  @db.VarChar(255)
  role         UserRole @default(EDITOR)
  is_active    Boolean  @default(true)
  expires_at   DateTime @db.Timestamptz
  created_at   DateTime @default(now()) @db.Timestamptz

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("trip_invites")
}

// -----------------------------------------------------------------------------
// 5. EXPLORE, SOCIAL & COMMUNITY MODULE
// -----------------------------------------------------------------------------

model TripLike {
  user_id    String   @db.Uuid
  trip_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@id([user_id, trip_id])
  @@map("trip_likes")
}

model TripBookmark {
  user_id    String   @db.Uuid
  trip_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@id([user_id, trip_id])
  @@map("trip_bookmarks")
}

model TripComment {
  id         String   @id @default(uuid()) @db.Uuid
  trip_id    String   @db.Uuid
  user_id    String   @db.Uuid
  content    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("trip_comments")
}

// -----------------------------------------------------------------------------
// 6. UTILITIES & CHECKLIST MODULE
// -----------------------------------------------------------------------------

model TripChecklist {
  id          String   @id @default(uuid()) @db.Uuid
  trip_id     String   @db.Uuid
  item_name   String   @db.VarChar(255)
  category    String?  @db.VarChar(50)
  is_checked  Boolean  @default(false)
  order_index Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("trip_checklists")
}
