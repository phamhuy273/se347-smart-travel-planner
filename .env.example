# ==============================================================================
# WANDERFLOW / TRIPPLANNER (SE347) - ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values if needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (POSTGRESQL & PRISMA)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wanderflow_db
POSTGRES_PORT=5432

# Connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wanderflow_db?schema=public"

# ------------------------------------------------------------------------------
# 2. BACKEND API (NESTJS)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_wanderflow_jwt_key_2026_se347_development
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_wanderflow_refresh_jwt_key_2026_se347
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (MEDIA & IMAGE STORAGE)
# Sign up free at https://cloudinary.com to get your credentials
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. FRONTEND MAPBOX GL JS
# Get your free public token at https://account.mapbox.com
# ------------------------------------------------------------------------------
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiZGV2LXVzZXIiLCJhIjoiY2x0cmF2ZWxwbGFubmVyZGV2bW9kZSJ9.wanderflow_dev_token
VITE_API_BASE_URL=http://localhost:3000/api/v1
